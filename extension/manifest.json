{
  "manifest_version": 3,
  "name": "B Design — Save to B Design",
  "version": "1.4.0",
  "description": "Hover or right-click any image on the web and send it into your B Design pipeline. Generation continues on the server after you close the tab.",
  "permissions": ["contextMenus", "storage", "notifications", "alarms"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "48": "icon.png", "128": "icon.png" }
  },
  "background": { "service_worker": "background.js" },
  "icons": { "48": "icon.png", "128": "icon.png" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": [
        "*://autodesigner.lovable.app/*",
        "*://bdesign.teambecause.com/*",
        "*://*.lovable.app/*",
        "*://*.lovableproject.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "*://autodesigner.lovable.app/*",
        "*://bdesign.teambecause.com/*"
      ],
      "js": ["app-sync.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    { "resources": ["icon.png"], "matches": ["<all_urls>"] }
  ]
}
